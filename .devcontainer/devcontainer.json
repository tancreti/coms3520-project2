// Dev container for COM S 3520 Project 2.
// Format: https://containers.dev/implementors/json_reference/
{
	"name": "COM S 3520 Ubuntu Project 2",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Let gdb disable address-space randomization and trace the test
	// processes, and let make tsan turn randomization off.
	"runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],

	// C/C++ support in VS Code: code completion, error squiggles, and the
	// graphical debugger (which uses the container's gdb).
	"customizations": {
		"vscode": {
			"extensions": ["ms-vscode.cpptools"]
		}
	}
}
